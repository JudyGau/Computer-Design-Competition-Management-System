---
import { convertPathToHtml } from "../../../utils/index.js";
const { path, mainPage, page } = Astro.props;
const htmlPath = convertPathToHtml(path);
---

<!--begin::Sidebar-->
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <!--begin::Sidebar Brand-->
  <div class="sidebar-brand">
    <!--begin::Brand Link-->
    <a href={htmlPath + "/index.html"} class="brand-link">
      <!--begin::Brand Image-->
      <img
        src={path + "/assets/img/jsjdsLogo.png"}
        alt="AdminLTE Logo"
        class="brand-image opacity-75 shadow"
      />
      <!--end::Brand Image-->
      <!--begin::Brand Text-->
      <span class="brand-text fw-light">计算机设计大赛</span>
      <!--end::Brand Text-->
    </a>
    <!--end::Brand Link-->
  </div>
  <!--end::Sidebar Brand-->
  <!--begin::Sidebar Wrapper-->
  <div class="sidebar-wrapper">
    <nav class="mt-2">
      <!--begin::Sidebar Menu-->
      <ul
        class="nav sidebar-menu flex-column"
        data-lte-toggle="treeview"
        role="menu"
        data-accordion="false"
      >
        <li class:list={["nav-item", mainPage === "reviewer" && "active"]}>
          <a
            href={"https://jsjds.blcu.edu.cn/"}
            class:list={["nav-link", page === "home" && "active"]}
          >
            <i class="nav-icon bi bi-star"></i>
            <p>大赛官网</p>
          </a>
        </li>

        <li class:list={["nav-item", mainPage === "reviewer" && "active"]}>
          <a
            href={htmlPath + "/reviewer/work-review.html"}
            class:list={["nav-link", page === "work-review" && "active"]}
          >
            <i class="nav-icon bi bi-person"></i>
            <p>作品审核</p>
          </a>
        </li>

        <li class:list={["nav-item", mainPage === "reviewer" && "active"]}>
          <a
            href={htmlPath + "/reviewer/security.html"}
            class:list={["nav-link", page === "security" && "active"]}
          >
            <i class="nav-icon bi bi-lock"></i>
            <p>账号安全</p>
          </a>
        </li>
        <li class:list={["nav-item", mainPage === "reviewer" && "active"]}>
          <a
            href="#"
            class:list={["nav-link", page === "logout" && "active"]}
            id="logout"
          >
            <i class="nav-icon bi bi-box-arrow-in-left"></i>
            <p>退出登录</p>
          </a>
        </li>
      </ul>
      <!--end::Sidebar Menu-->
    </nav>
  </div>
  <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->
<script>
  function logout() {
    fetch("http://localhost:8080/reviewerLogout", {
      method: "GET",
      credentials: "include", // 确保带上 Cookies
      headers: {
        "Content-Type": "application/json",
      },
    })
      .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
      .then((data) => {
        console.log(data.data);

        if (data.code === 200) {
          // 登录成功后处理
          alert("成功退出登录");
          window.location.href = "/logins/reviewer-login"; // 默认跳转到个人信息页面
        } else {
          alert(data.message); // 登录失败时的提示
        }
      })
      .catch((error) => {
        console.error("请求失败:", error);
        alert("登录失败，请重试。");
      });
  }
  document.getElementById("logout").addEventListener("click", logout);
</script>
