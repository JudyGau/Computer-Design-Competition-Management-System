---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/school-manager-sidenav.astro";

const title = "校管理员 - 省赛作品管理";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "school-manager";
const page = "province-work-manage";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
    <style>
      .group-form {
        display: flex;
        gap: 2rem;
        padding: 1.5rem;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin: 1.5rem auto;
        max-width: 500px;
      
        justify-content: center;
        align-items: center;
      }

      .input-group {
        flex: 1;
        min-width: 180px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #2d3748;
        font-size: 0.9rem;
      }

      .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #4a5568;
        font-size: 1rem;
        text-align: center;
        transition: border-color 0.3s ease;
      }

      .form-input:read-only {
        background: #f8fafc;
        border-color: #e2e8f0;
      }

      /* 响应式设计 */
      @media (max-width: 768px) {
        .group-form {
          flex-direction: column;
          gap: 1rem;
        }

        .input-group {
          width: 100%;
        }
      }

      /* 可选：添加微交互效果 */
      .form-input:hover {
        border-color: #cbd5e0;
      }

      .form-input:focus {
        outline: none;
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
      }
    </style>
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%;height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">推送作品到省赛</p>
          <form id="groupForm" class="group-form">
            <div class="input-group">
              <label class="form-label">省赛名额</label>
              <input
                type="text"
                class="form-input"
                id="quota"
                placeholder="参赛名额"
                disabled
              />
            </div>

            <div class="input-group">
              <button
                id="auto-send"
                type="button"
                class="btn btn-primary">一键推送</button
              >
            </div>
          </form>
        </div>
        <div class="card-body login-card-body">
          <p class="login-box-msg">晋级到省赛的作品</p>
          <table
            class="table table-head-fixed table-bordered text-center table-valign-middle"
          >
            <thead>
              <tr>
                <th>作品大类</th>
                <th>作品小类</th>
                <th>作品名称</th>
                <th>校赛得分</th>
                <th>是否进入省赛</th>
                <th>省赛审核状态</th>
                <th>省赛得分</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="work-list">
              <!-- 可以继续添加更多的行 -->
            </tbody>
          </table>
          <!-- 添加分页控件 -->
          <div class="pagination justify-content-center mt-3">
            <button id="prevBtn" class="btn btn-outline-primary btn-sm"
              >上一页</button
            >
            <span id="pageNumbers" class="mx-2"></span>
            <button id="nextBtn" class="btn btn-outline-primary btn-sm"
              >下一页</button
            >
          </div>
        </div>
      </div>
      <Footer />
    </div>
    <script>
      document.getElementById("auto-send").onclick = function () {
        fetch(
          `http://localhost:8080/schoolManager/autoSendWorkToProvinceCompetition?`,
          {
            method: "get",
            credentials: "include", // 确保带上 Cookies
            headers: {
              "Content-Type": "application/json",
            },
          }
        )
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);

            if (data.code === 200) {
              alert("自动推送完成");
            } else {
              alert(data.message); // 操作失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

      // 分页相关变量
      let currentPage = 1;
      const itemsPerPage = 10;
      let items = []; // 存储全部数据

      // 初始化函数
      function initPagination() {
        // 事件绑定
        document
          .getElementById("prevBtn")
          .addEventListener("click", () => changePage(-1));
        document
          .getElementById("nextBtn")
          .addEventListener("click", () => changePage(1));
      }

      // 渲染表格内容
      function renderTable() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = items.slice(start, end);

        const workList = document.getElementById("work-list");
        workList.innerHTML = pageData
          .map(
            (item) => `
                <tr class="align-middle" key="${item.workName}">
                  <td>${item.category}</td>
                  <td>${item.subclass}</td>
                  <td>${item.workName}</td>
                  <td>${item.schoolCompetitionScore}</td>
                  <td>${item.isProvinceCompetition == 1 ? "是" : "否"}</td>
                  <td>${item.isProvinceCompetition == 1 ? (item.isApproved == 1 ? "通过" : item.isApproved == 2 ? "不通过" : "未审核") : "-"}</td>
                  <td>${item.isProvinceCompetition == 1 ? (item.score == -1 ? "未评分" : item.score) : "-"}</td>
                  <td><button type="button" id="download-work" class="btn btn-outline-primary" data-workName="${item.workName}">下载</button></td>
                  
                </tr>
              `
          )
          .join("");
        // <td><button type="button" id="send" class="btn btn-outline-success" data-workName="${item.workName}">推送</button></td>
        // 重新绑定事件
        bindButtonEvents();
        // 更新分页状态
        renderPagination();
      }

      // 生成分页按钮
      function renderPagination() {
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const pageNumbers = document.getElementById("pageNumbers");
        pageNumbers.innerHTML = "";

        // 显示页码范围（最多显示5个）
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement("button");
          btn.className = `btn btn-sm mx-1 ${i === currentPage ? "btn-primary" : "btn-outline-primary"}`;
          btn.textContent = i;
          btn.addEventListener("click", () => goToPage(i));
          pageNumbers.appendChild(btn);
        }

        // 控制按钮状态
        document.getElementById("prevBtn").disabled = currentPage === 1;
        document.getElementById("nextBtn").disabled =
          currentPage === totalPages;
      }

      // 分页控制函数
      function changePage(step) {
        currentPage = Math.max(1, currentPage + step);
        renderTable();
      }

      function goToPage(page) {
        currentPage = page;
        renderTable();
      }

      // 按钮事件绑定函数
      function bindButtonEvents() {
        // 给每个下载按钮添加点击事件
        document.querySelectorAll("#download-work").forEach((button) => {
          button.addEventListener("click", function () {
            const workName = this.getAttribute("data-workName");
            // 在这里处理下载逻辑
            console.log(`下载作品 workName: ${workName}`);
            fetch(
              `http://localhost:8080/schoolManager/downloadWork?workName=${workName}`,
              {
                method: "get",
                credentials: "include",
              }
            )
              .then((response) => response.blob()) // 将响应转为 blob 对象
              .then((blob) => {
                // 创建一个 URL 链接指向下载文件
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob); // 创建一个指向文件的 URL
                link.download = workName; // 设置下载文件的名字
                link.click(); // 自动点击下载链接
                URL.revokeObjectURL(link.href); // 清理 URL 对象
              })
              .catch((error) => {
                console.error("下载文件失败:", error);
                alert("下载失败！");
              });
          });
        });

        // document.querySelectorAll("#send").forEach((button) => {
        //   button.addEventListener("click", function () {
        //     const workName = this.getAttribute("data-workName");
        //     // 在这里处理推送逻辑
        //     console.log(`推送作品 workName: ${workName}`);
        //     fetch(
