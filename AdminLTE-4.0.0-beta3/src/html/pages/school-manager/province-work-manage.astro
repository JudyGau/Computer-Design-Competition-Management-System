        //         }
        //       })
        //       .catch((error) => {
        //         console.error("请求失败:", error);
        //         alert("请求失败，请重试。");
        //       });
        //   });
        // });
      }

      // 初始化分页
      initPagination();

      window.onload = function () {
        fetch(`http://localhost:8080/schoolManager/getProvinceQuotaOfSchool`, {
          method: "get",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              console.log(data.data);
              document.querySelector("#quota").value = data.data;
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });

        fetch(`http://localhost:8080/schoolManager/getProvinceWorkOfSchool`, {
          method: "get",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              console.log(data.data);
              items = data.data; // 保存全部数据
              renderTable(); // 初始化渲染
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

