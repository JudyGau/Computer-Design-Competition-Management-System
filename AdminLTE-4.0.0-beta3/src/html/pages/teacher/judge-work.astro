      //         let items = data.data;
      //         workList.innerHTML = items
      //           .map(
      //             (item) => `
      //           <tr class="align-middle" key="${item.workName}">
      //             <td>${item.category}</td>
      //             <td>${item.subclass}</td>
      //             <td>${item.workName}</td>
      //             <td>${item.isProvinceCompetition == 1 ? "是" : "否"}</td>
      //             <td>${item.score == -1 ? "未评分" : item.score}</td>
      //             <td><button type="button" id="judge-work" class="btn btn-outline-primary" data-workName="${item.workName}">评分</button></td>
      //             <td><button type="button" id="download-work" class="btn btn-outline-primary" data-workName="${item.workName}">下载</button></td>
      //           </tr>
      //         `
      //           )
      //           .join("");
      //         // 打开弹窗
      //         document.querySelectorAll("#judge-work").forEach((button) => {
      //           button.addEventListener("click", function () {
      //             modal.style.display = "block";
      //             workName = this.getAttribute("data-workName");
      //             console.log(`评分作品 workName: ${workName}`);
      //           });
      //         });

      //         // 给每个下载按钮添加点击事件
      //         document.querySelectorAll("#download-work").forEach((button) => {
      //           button.addEventListener("click", function () {
      //             const workName = this.getAttribute("data-workName");
      //             // 在这里处理下载逻辑
      //             console.log(`下载作品 workName: ${workName}`);
      //             fetch(
      //               `http://localhost:8080/judge/downloadWork?workName=${workName}`,
      //               {
      //                 method: "get",
      //                 credentials: "include",
      //               }
      //             )
      //               .then((response) => response.blob()) // 将响应转为 blob 对象
      //               .then((blob) => {
      //                 // 创建一个 URL 链接指向下载文件
      //                 const link = document.createElement("a");
      //                 link.href = URL.createObjectURL(blob); // 创建一个指向文件的 URL
      //                 link.download = workName; // 设置下载文件的名字
      //                 link.click(); // 自动点击下载链接
      //                 URL.revokeObjectURL(link.href); // 清理 URL 对象
      //               })
      //               .catch((error) => {
      //                 console.error("下载文件失败:", error);
      //                 alert("下载失败！");
      //               });
      //           });
      //         });
      //       } else {
      //         alert(data.message); // 操作失败时的提示
      //       }
      //     })
      //     .catch((error) => {
      //       console.error("请求失败:", error);
      //       alert("登录失败，请重试。");
      //     });
      // };

      // 获取元素

      var modal = document.getElementById("myModal");
      var span = document.getElementsByClassName("close")[0];
      var submitBtn = document.getElementById("submitBtn");
      var workName;

      // 点击提交按钮
      submitBtn.onclick = function () {
        // 获取表单数据
        const score = document.querySelector('[name="score"]').value;

        fetch(
          `http://localhost:8080/teacher/judgeWork?score=${score}&workName=${workName}`,
          {
            method: "get",
            credentials: "include", // 确保带上 Cookies
            headers: {
              "Content-Type": "application/json",
            },
          }
        )
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);

            if (data.code === 200) {
              // 保存成功后处理
              modal.style.display = "none";
              alert("评分成功");
              window.location.href = "../teacher/judge-work.html";
            } else {
              alert(data.message); // 保存失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };
      // 关闭弹窗
      span.onclick = function () {
        modal.style.display = "none";
      };

      // 点击弹窗外区域关闭弹窗
      window.onclick = function (event) {
        if (event.target === modal) {
          modal.style.display = "none";
        }
      };
    </script>

    <Scripts path={path} />
  </body>
</html>
