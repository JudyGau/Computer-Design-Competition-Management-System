---
// 导入所需组件
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/teacher-sidenav.astro";

// 设置页面的基本属性
const title = "教师 - 消息管理";
const path = "../../../dist";
const mainPage = "teacher";
const page = "message-manage";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%; height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">申请列表</p>
          <table
            class="table table-head-fixed table-bordered text-center table-valign-middle"
          >
            <thead>
              <tr class="align-middle"> </tr>
            </thead>
            <tbody id="apply-list">
              <!-- 数据将通过 JavaScript 填充 -->
            </tbody>
          </table>
          <!-- 添加分页控件 -->
          <div class="pagination justify-content-center mt-3">
            <button id="prevBtn" class="btn btn-outline-primary btn-sm"
              >上一页</button
            >
            <span id="pageNumbers" class="mx-2"></span>
            <button id="nextBtn" class="btn btn-outline-primary btn-sm"
              >下一页</button
            >
          </div>
        </div>
      </div>
      <Footer />
    </div>
    <Scripts path={path} />
    <script>
      // 分页相关变量
      let currentPage = 1;
      const itemsPerPage = 10;
      let items = []; // 存储全部数据

      // 初始化函数
      function initPagination() {
        // 事件绑定
        document
          .getElementById("prevBtn")
          .addEventListener("click", () => changePage(-1));
        document
          .getElementById("nextBtn")
          .addEventListener("click", () => changePage(1));
      }

      // 渲染表格内容
      function renderTable() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = items.slice(start, end);

        const applyList = document.getElementById("apply-list");
        applyList.innerHTML = pageData
          .map(
            (item) => `
            <tr class="align-middle">
              <td>学生 ${item.name}(${item.studentId}) 申请加入队伍 ${item.applyGroupName}     
              <button type="button" style="margin-left:10px;" id="accept-apply" class="btn btn-outline-success" data-school="${item.school}" data-studentId="${item.studentId}" data-applyGroupName="${item.applyGroupName}">同意</button>
              <button type="button" style="margin-left:10px;" id="refuse-apply" class="btn btn-outline-danger" data-school="${item.school}" data-studentId="${item.studentId}" data-applyGroupName="${item.applyGroupName}">拒绝</button>
              </td>
            </tr>
          `
          )
          .join("");

        // 重新绑定事件
        bindButtonEvents();
        // 更新分页状态
        renderPagination();
      }

      // 生成分页按钮
      function renderPagination() {
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const pageNumbers = document.getElementById("pageNumbers");
        pageNumbers.innerHTML = "";

        // 显示页码范围（最多显示5个）
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement("button");
          btn.className = `btn btn-sm mx-1 ${i === currentPage ? "btn-primary" : "btn-outline-primary"}`;
          btn.textContent = i;
          btn.addEventListener("click", () => goToPage(i));
          pageNumbers.appendChild(btn);
        }

        // 控制按钮状态
        document.getElementById("prevBtn").disabled = currentPage === 1;
        document.getElementById("nextBtn").disabled =
          currentPage === totalPages;
      }

      // 分页控制函数
      function changePage(step) {
        currentPage = Math.max(1, currentPage + step);
        renderTable();
      }

      function goToPage(page) {
        currentPage = page;
        renderTable();
      }

      // 按钮事件绑定函数
      function bindButtonEvents() {
        // 给每个同意按钮添加点击事件
        document.querySelectorAll("#accept-apply").forEach((button) => {
          button.addEventListener("click", function () {
            // 获取表单数据
            const formData = {
              school: this.getAttribute("data-school"),
              studentId: this.getAttribute("data-studentId"),
              applyGroupName: this.getAttribute("data-applyGroupName"),
            };
            console.log(`处理申请: ${formData}`);
            // 在这里处理同意逻辑
            fetch(`http://localhost:8080/teacher/acceptApplyOfStudent`, {
              method: "post",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(formData),
            })
              .then((response) => response.json())
              .then((data) => {
                console.log(data);
                if (data.code == 200) {
                  alert("同意申请成功");
                  window.location.href = `../teacher/manage-group.html`;
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });
        // 给每个拒绝按钮添加点击事件
        document.querySelectorAll("#refuse-apply").forEach((button) => {
          button.addEventListener("click", function () {
            // 获取表单数据
            const formData = {
              school: this.getAttribute("data-school"),
              studentId: this.getAttribute("data-studentId"),
              applyGroupName: this.getAttribute("data-applyGroupName"),
            };
            console.log(`处理申请: ${formData}`);
            // 在这里处理拒绝逻辑
            fetch(`http://localhost:8080/teacher/refuseApplyOfStudent`, {
              method: "post",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(formData),
            })
              .then((response) => response.json())
              .then((data) => {
                console.log(data);
                if (data.code == 200) {
                  alert("拒绝申请成功");
                  window.location.href = `../teacher/manage-group.html`;
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });
      }

      // 初始化分页
      initPagination();

      window.onload = function () {
        fetch(
          `http://localhost:8080/teacher/getStudentApplyingGroupOfTeacher`,
          {
            method: "get",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
          }
        )
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              console.log(data.data); // 打印返回的内容
              items = data.data; // 保存全部数据
              renderTable(); // 初始化渲染
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

