---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Topbar from "../../components/dashboard/_topbar.astro";
import Sidenav from "../../components/dashboard/_sidenav.astro";
import Footer from "../../components/dashboard/_footer.astro";

const title = "教师 - 注册";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "registers";
const page = "teacher-register";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <!-- /.register-logo -->
      <div class="card">
        <div class="card-body register-card-body">
          <p class="register-box-msg">教师注册</p>

          <form
            id="registerForm"
            action="http://localhost:8080/teacherRegister"
            method="post"
          >
            <div class="input-group mb-3">
              <input
                type="text"
                class="form-control"
                placeholder="姓名"
                name="name"
              />
            </div>
            <div class="input-group mb-3">
              <input
                type="text"
                class="form-control"
                placeholder="学校"
                name="school"
              />
            </div>
            <div class="input-group mb-3">
              <input
                type="text"
                class="form-control"
                placeholder="工号"
                name="teacherId"
              />
            </div>

            <div class="input-group mb-3">
              <input
                type="password"
                class="form-control"
                placeholder="密码"
                name="password"
              />
            </div>
            <div class="input-group mb-3">
              <input
                type="password"
                class="form-control"
                placeholder="确认密码"
                name="rePassword"
              />
            </div>
            <div class="input-group mb-3">
              <input
                type="text"
                class="form-control"
                placeholder="电话"
                name="telephone"
              />
            </div>
            <div class="input-group mb-3">
              <input
                type="text"
                class="form-control"
                placeholder="电子邮箱"
                name="email"
              />
            </div>
            <!-- <div class="input-group mb-3">
              <input
                type="password"
                class="form-control"
                placeholder="验证码"
                name=""
              />
            </div> -->
            <!--begin::Row-->
            <div class="row">
              <div class="col-8">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value=""
                    id="flexCheckDefault"
                  />
                  <label class="form-check-label" for="flexCheckDefault">
                    同意<a href="#">条款</a>
                  </label>
                </div>
              </div>
              <!-- /.col -->
              <div class="col-4">
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">注册</button>
                </div>
              </div>
              <!-- /.col -->
            </div>
            <!--end::Row-->
          </form>

          <!-- /.social-auth-links -->

          <p class="mb-0">
            <a href="../logins/teacher-login.html" class="text-center">
              已有账号
            </a>
          </p>
        </div>
        <!-- /.register-card-body -->
      </div>
      <Footer />
    </div>

    <script>
      document
        .getElementById("registerForm")
        .addEventListener("submit", function (event) {
          event.preventDefault(); // 阻止默认的表单提交行为

          // 获取表单数据
          const formData = {
            name: document.querySelector('[name="name"]').value,
            school: document.querySelector('[name="school"]').value,
            teacherId: document.querySelector('[name="teacherId"]').value,
            password: document.querySelector('[name="password"]').value,
            rePassword: document.querySelector('[name="rePassword"]').value,
            telephone: document.querySelector('[name="telephone"]').value,
            email: document.querySelector('[name="email"]').value,
          };

          fetch("http://localhost:8080/teacherRegister", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(formData), // 发送表单数据
          })
            .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
            .then((data) => {
              console.log(data);

              if (data.code === 200) {
                // 登录成功后处理
                window.location.href = "../logins/teacher-login.html"; // 默认跳转到登录页面
              } else {
                alert(data.message); // 登录失败时的提示
              }
            })
            .catch((error) => {
              console.error("请求失败:", error);
              alert("登录失败，请重试。" + error);
            });
        });
    </script>

    <Scripts path={path} />
  </body>
</html>
