---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/reviewer-sidenav.astro";

const title = "计算机设计大赛 省赛作品审核";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "reviewer";
const page = "work-review";
---

<!doctype html>
<html lang="cn">
  <!--begin::Head-->
  <head>
    <style>
      .input-group {
        flex: 1;
        min-width: 180px;
      }
      .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #4a5568;
        font-size: 1rem;
        text-align: left;
        transition: border-color 0.3s ease;
      }
      .form-input:read-only {
        background: #f8fafc;
        border-color: #e2e8f0;
      }
      /* 响应式设计 */
      @media (max-width: 768px) {
        .group-form {
          flex-direction: column;
          gap: 1rem;
        }

        .input-group {
          width: 100%;
        }
      }

      /* 可选：添加微交互效果 */
      .form-input:hover {
        border-color: #cbd5e0;
      }

      .form-input:focus {
        outline: none;
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
      }
      /* 弹窗样式 */
      .modal {
        display: none; /* 初始时隐藏 */
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 400px;
      }

      .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
      }

      .close:hover,
      .close:focus {
        color: black;
        text-decoration: none;
        cursor: pointer;
      }
    </style>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%;height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">审核</p>
          <table class="table table-bordered text-center table-valign-middle">
            <thead>
              <tr>
                <th>作品大类</th>
                <th>作品小类</th>
                <th>作品名称</th>
                <th>审核状态</th>
                <th>操作</th>

                <th>操作</th>
              </tr>
            </thead>
            <tbody id="work-list">
              <!-- 可以继续添加更多的行 -->
            </tbody>
          </table>
          <!-- 添加分页控件 -->
          <div class="pagination justify-content-center mt-3">
            <button id="prevBtn" class="btn btn-outline-primary btn-sm"
              >上一页</button
            >
            <span id="pageNumbers" class="mx-2"></span>
            <button id="nextBtn" class="btn btn-outline-primary btn-sm"
              >下一页</button
            >
          </div>
        </div>
        <!-- 弹窗 -->
        <div id="myModal" class="modal">
          <div class="modal-content">
            <span class="close">&times;</span>
            <form id="makeReviewerForm">
              <div class="input-group mb-3">
                <input
                  type="text"
                  class="form-input"
                  placeholder="不通过原因"
                  name="comment"
                />
              </div>

              <!--begin::Row-->
              <div class="row">
                <div class="col-4">
                  <div class="d-grid gap-2">
                    <button id="submitBtn" type="button" class="btn btn-primary"
                      >提交</button
                    >
                  </div>
                </div>
              </div>
              <!--end::Row-->
            </form>
          </div>
        </div>
      </div>
      <Footer />
    </div>

    <script>
      // 分页相关变量
      let currentPage = 1;
      const itemsPerPage = 10;
      let items = []; // 存储全部数据

      // 初始化函数
      function initPagination() {
        // 事件绑定
        document
          .getElementById("prevBtn")
          ?.addEventListener("click", () => changePage(-1));
        document
          .getElementById("nextBtn")
          ?.addEventListener("click", () => changePage(1));
      }

      // 渲染表格内容
      function renderTable() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = items.slice(start, end);

        const workList = document.getElementById("work-list");
        workList.innerHTML = pageData
          .map(
            (item) => `
                <tr class="align-middle" key="${item.workName}">
                  <td>${item.category}</td>
                  <td>${item.subclass}</td>
                  <td>${item.workName}</td>
                  <td>${item.isApproved == 0 ? "未审核" : item.isApproved == 1 ? "通过" : "不通过"}</td>
                  <td>
                    ${
                      item.isApproved != 1
                        ? `<button type="button" id="pass" class="btn btn-outline-success" data-workName="${item.workName}">通过</button>      <button type="button" id="fail" class="btn btn-outline-danger" data-workName="${item.workName}">不通过</button>`
                        : `——`
                    }
                  
                   
                  </td>
                  <td><button type="button" id="download-work" class="btn btn-outline-primary" data-workName="${item.workName}">下载</button></td>
                </tr>
              `
          )
          .join("");

        // 重新绑定事件
        bindButtonEvents();
        // 更新分页状态
        renderPagination();
      }

      // 生成分页按钮
      function renderPagination() {
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const pageNumbers = document.getElementById("pageNumbers");
        pageNumbers.innerHTML = "";

        // 显示页码范围（最多显示5个）
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement("button");
          btn.className = `btn btn-sm mx-1 ${i === currentPage ? "btn-primary" : "btn-outline-primary"}`;
          btn.textContent = i;
          btn.addEventListener("click", () => goToPage(i));
          pageNumbers.appendChild(btn);
        }

        // 控制按钮状态
        document.getElementById("prevBtn").disabled = currentPage === 1;
        document.getElementById("nextBtn").disabled =
          currentPage === totalPages;
      }

      // 分页控制函数
      function changePage(step) {
        currentPage = Math.max(1, currentPage + step);
        renderTable();
      }

      function goToPage(page) {
        currentPage = page;
        renderTable();
      }

      // 按钮事件绑定函数
      function bindButtonEvents() {
        // 给每个审核通过按钮添加点击事件
        document.querySelectorAll("#pass").forEach((button) => {
          button.addEventListener("click", function () {
            const comment = "作品符合大赛规定，审核通过！";
            const workName = this.getAttribute("data-workName");
            const isApproved = 1;
            // 在这里处理审核通过逻辑
            console.log(`审核通过作品 workName: ${workName}`);
            fetch(
              `http://localhost:8080/reviewer/reviewWork?isApproved=${isApproved}&workName=${workName}&commen=${comment}`,
              {
                method: "get",
                credentials: "include",
                headers: {
                  "Content-Type": "application/json",
                },
              }
            )
              .then((response) => response.json())
              .then((data) => {
                if (data.code == 200) {
                  alert("审核通过作品成功");
                  window.location.href = "../reviewer/work-review.html";
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });

        // 给每个审核不通过按钮添加点击事件
        document.querySelectorAll("#fail").forEach((button) => {
          button.addEventListener("click", function () {
            modal.style.display = "block";
            workName = this.getAttribute("data-workName");
            console.log(`评分作品 workName: ${workName}`);
          });
          // button.addEventListener("click", function () {
          //   const workName = this.getAttribute("data-workName");
          //   const isApproved = 2;
          //   // 在这里处理审核不通过逻辑
          //   console.log(`审核不通过作品 workName: ${workName}`);
