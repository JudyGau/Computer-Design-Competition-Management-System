        });

        // 给每个下载按钮添加点击事件
        document.querySelectorAll("#download-work").forEach((button) => {
          button.addEventListener("click", function () {
            const workName = this.getAttribute("data-workName");
            // 在这里处理下载逻辑
            console.log(`下载作品 workName: ${workName}`);
            fetch(
              `http://localhost:8080/reviewer/downloadWork?workName=${workName}`,
              {
                method: "get",
                credentials: "include",
              }
            )
              .then((response) => response.blob()) // 将响应转为 blob 对象
              .then((blob) => {
                // 创建一个 URL 链接指向下载文件
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob); // 创建一个指向文件的 URL
                link.download = workName; // 设置下载文件的名字
                link.click(); // 自动点击下载链接
                URL.revokeObjectURL(link.href); // 清理 URL 对象
              })
              .catch((error) => {
                console.error("下载文件失败:", error);
                alert("下载失败！");
              });
          });
        });
      }

      // 初始化分页
      initPagination();

      window.onload = function () {
        fetch(`http://localhost:8080/reviewer/getWorkOfProvinceCompetition`, {
          method: "get",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              console.log(data.data);
              items = data.data; // 保存全部数据
              renderTable(); // 初始化渲染
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

      var modal = document.getElementById("myModal");
      var span = document.getElementsByClassName("close")[0];
      var submitBtn = document.getElementById("submitBtn");
      var workName;

      // 关闭弹窗
      span.onclick = function () {
        modal.style.display = "none";
      };

      // 点击提交按钮
      submitBtn.onclick = function () {
        // 获取表单数据
        const comment = document.querySelector('[name="comment"]').value;

        const isApproved = 2;
        // 在这里处理审核不通过逻辑
        console.log(`审核不通过作品 workName: ${workName}`);
        fetch(
          `http://localhost:8080/reviewer/reviewWork?isApproved=${isApproved}&workName=${workName}&comment=${comment}`,
          {
            method: "get",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
            },
          }
        )
          .then((response) => response.json())
          .then((data) => {
            if (data.code == 200) {
              alert("作品审核不通过，操作成功");
              window.location.href = "../reviewer/work-review.html";
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

      // 点击弹窗外区域关闭弹窗
      window.onclick = function (event) {
        if (event.target === modal) {
          modal.style.display = "none";
        }
      };

