---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/student-sidenav.astro";

const title = "学生 - 我的队伍";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "student";
const page = "my-group";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
    <style>
      .group-form {
        display: flex;
        gap: 2rem;
        padding: 1.5rem;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin: 1.5rem auto;
        max-width: 800px;
      }

      .input-group {
        flex: 1;
        min-width: 180px;
      }

      .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #2d3748;
        font-size: 0.9rem;
      }

      .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #4a5568;
        font-size: 1rem;
        text-align: center;
        transition: border-color 0.3s ease;
      }

      .form-input:read-only {
        cursor: not-allowed;
        background: #f8fafc;
        border-color: #e2e8f0;
      }

      /* 响应式设计 */
      @media (max-width: 768px) {
        .group-form {
          flex-direction: column;
          gap: 1rem;
        }

        .input-group {
          width: 100%;
        }
      }

      /* 可选：添加微交互效果 */
      .form-input:hover {
        border-color: #cbd5e0;
      }

      .form-input:focus {
        outline: none;
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
      }
    </style>
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%;height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">队伍信息</p>
          <form id="groupForm" class="group-form">
            <div class="input-group">
              <label class="form-label">队名</label>
              <input type="text" class="form-input" name="groupName" readonly />
            </div>
            <div class="input-group">
              <label class="form-label">人数</label>
              <input type="text" class="form-input" name="number" readonly />
            </div>
            <div class="input-group">
              <label class="form-label">指导教师</label>
              <input type="text" class="form-input" name="teacher" readonly />
            </div>
          </form>
        </div>
        <div class="card-body login-card-body">
          <p class="login-box-msg">成员</p>
          <table
            class="table table-head-fixed table-bordered text-center table-valign-middle"
          >
            <thead>
              <tr>
                <th>姓名</th>
                <th>学号</th>
                <th>学校</th>
                <th>年级</th>
                <th>专业</th>
                <th>电话</th>
              </tr>
            </thead>
            <tbody id="student-list"></tbody>
          </table>
        </div>

        <div class="card-body login-card-body">
          <p class="login-box-msg">作品</p>
          <table
            class="table table-head-fixed table-bordered text-center table-valign-middle"
          >
            <thead>
              <tr>
                <th>作品大类</th>
                <th>作品小类</th>
                <th>作品名称</th>
                <th>状态</th>
                <th>校赛</th>
                <th>省赛</th>
                <th>操作</th>
                <th>操作</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="work-list">
              <!-- 可以继续添加更多的行 -->
            </tbody>
          </table>
        </div>
      </div>
      <Footer />
    </div>
    <script>
      window.onload = function () {
        fetch(`http://localhost:8080/student/getGroupInfo`, {
          method: "get",
          credentials: "include", // 确保带上 Cookies
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);

            if (data.code === 200) {
              // 操作成功后处理
              document.querySelector('[name="groupName"]').value =
                data.data.groupName;
              document.querySelector('[name="number"]').value =
                data.data.number;
              document.querySelector('[name="teacher"]').value =
                data.data.teacherId;
            } else {
              alert(data.message); // 操作失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("登录失败，请重试。");
          });

        fetch(`http://localhost:8080/student/getStudentOfGroup`, {
          method: "get",
          credentials: "include", // 确保带上 Cookies
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);
            if (data.code === 200) {
              const studentList = document.getElementById("student-list");
              let items = data.data;
              studentList.innerHTML = items
                .map(
                  (item) => `
                <tr class="align-middle" key="${item.studentId}">
                  <td>${item.name}</td>
                  <td>${item.studentId}</td>
                  <td>${item.school}</td>
                  <td>${item.grade}</td>
                  <td>${item.major}</td>
                  <td>${item.telephone}</td>
                </tr>
              `
                )
                .join("");
            } else {
              alert(data.message); // 操作失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });

        fetch(`http://localhost:8080/student/getWorkOfGroup`, {
          method: "get",
          credentials: "include", // 确保带上 Cookies
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);

            if (data.code === 200) {
              const workList = document.getElementById("work-list");
              let items = data.data;
              workList.innerHTML = items
                .map(
                  (item) => `
                <tr class="align-middle" key="${item.workName}">
                  <td>${item.category}</td>
                  <td>${item.subclass}</td>
                  <td>${item.workName}</td>
                  <td>${item.isSubmitted == 1 ? "已提交文件" : "未提交文件"}</td>
                  <td>${item.isSchoolCompetition == 1 ? "是" : "否"}</td>
                  <td>${item.isProvinceCompetition == 1 ? "是" : "否"}</td>
                  <td><input type="file" name="file" id="${item.workName}" /></td>
                  <td><button type="button" id="upload-work" class="btn btn-outline-success" data-workName="${item.workName}">提交</button></td>
                  <td><button type="button" id="download-work" class="btn btn-outline-primary" data-workName="${item.workName}">下载</button></td>
                </tr>
              `
                )
                .join("");

              // 给每个提交按钮添加点击事件
              document.querySelectorAll("#upload-work").forEach((button) => {
                button.addEventListener("click", function () {
                  const workName = this.getAttribute("data-workName");
                  const fileInput = document.getElementById(workName);
                  const file = fileInput.files[0]; // 获取文件

                  if (!file) {
                    alert("请选择一个文件！");
                    return;
                  }

                  // 修改文件名
                  const newFileName =
                    workName + file.name.slice(file.name.lastIndexOf("."));

                  // 创建新的文件对象，保持原有文件的内容，但修改文件名
                  const newFile = new File([file], newFileName, {
                    type: file.type,
                  });

                  const fileData = new FormData();
                  fileData.append("file", newFile); // 将新的文件附加到FormData对象

                  // 使用fetch API发送POST请求
                  fetch("http://localhost:8080/student/uploadWork", {
                    method: "POST",
                    body: fileData,
                    credentials: "include", // 确保带上 Cookies
                  })
                    .then((response) => response.json()) // 假设返回的是JSON
                    .then((data) => {
                      if (data.code == 200) {
                        console.log("文件上传成功:", data);
                        alert("文件上传成功！");
                      } else {
                        alert(data.message);
                      }
                    })
                    .catch((error) => {
                      console.error("上传失败:", error);
                      alert("文件上传失败！");
                    });

                  fetch(
                    `http://localhost:8080/student/submitWork?workName=${workName}`,
                    {
                      method: "get",
                      credentials: "include",
                      headers: {
                        "Content-Type": "application/json",
                      },
                    }
                  )
                    .then((response) => response.json())
                    .then((data) => {
                      if (data.code == 200) {
                        alert("成功提交作品文件");
                        window.location.href = `../student/my-group.html`;
                      } else {
                        alert(data.message);
                      }
                    })
                    .catch((error) => {
                      console.error("请求失败:", error);
                      alert("请求失败，请重试。");
                    });
                });
              });

              // 给每个下载按钮添加点击事件
              document.querySelectorAll("#download-work").forEach((button) => {
                button.addEventListener("click", function () {
                  const workName = this.getAttribute("data-workName");
                  // 在这里处理下载逻辑
                  console.log(`下载作品 workName: ${workName}`);
                  fetch(
                    `http://localhost:8080/student/downloadWork?workName=${workName}`,
                    {
                      method: "get",
                      credentials: "include",
                    }
                  )
                    .then((response) => response.blob()) // 将响应转为 blob 对象
                    .then((blob) => {
                      // 创建一个 URL 链接指向下载文件
                      const link = document.createElement("a");
                      link.href = URL.createObjectURL(blob); // 创建一个指向文件的 URL
                      link.download = workName; // 设置下载文件的名字
                      link.click(); // 自动点击下载链接
                      URL.revokeObjectURL(link.href); // 清理 URL 对象
                    })
                    .catch((error) => {
                      console.error("下载文件失败:", error);
                      alert("下载失败！");
                    });
                });
              });
            } else {
              alert(data.message); // 操作失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("登录失败，请重试。");
          });
      };
    </script>

    <Scripts path={path} />
  </body>
</html>
