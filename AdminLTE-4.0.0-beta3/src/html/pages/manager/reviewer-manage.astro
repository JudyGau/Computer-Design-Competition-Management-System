---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/manager-sidenav.astro";

const title = "省赛管理员 - 评审管理";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "manager";
const page = "reviewer-manage";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <style>
      .input-group {
        flex: 1;
        min-width: 180px;
      }
      .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #4a5568;
        font-size: 1rem;
        text-align: left;
        transition: border-color 0.3s ease;
      }
      .form-input:read-only {
        background: #f8fafc;
        border-color: #e2e8f0;
      }
      /* 响应式设计 */
      @media (max-width: 768px) {
        .group-form {
          flex-direction: column;
          gap: 1rem;
        }

        .input-group {
          width: 100%;
        }
      }

      /* 可选：添加微交互效果 */
      .form-input:hover {
        border-color: #cbd5e0;
      }

      .form-input:focus {
        outline: none;
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
      }
      /* 弹窗样式 */
      .modal {
        display: none; /* 初始时隐藏 */
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 400px;
      }

      .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
      }

      .close:hover,
      .close:focus {
        color: black;
        text-decoration: none;
        cursor: pointer;
      }
    </style>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%;height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">评审列表</p>
          <table class="table table-bordered text-center table-valign-middle">
            <thead>
              <tr class="align-middle">
                <th>评审账号</th>
                <th>密码</th>
                <th>领域</th>
                <th>操作</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="reviewer-list">
              <!-- 可以继续添加更多的行 -->
            </tbody>
          </table>
          <!-- 添加分页控件 -->
          <div class="pagination justify-content-center mt-3">
            <button id="prevBtn" class="btn btn-outline-primary btn-sm"
              >上一页</button
            >
            <span id="pageNumbers" class="mx-2"></span>
            <button id="nextBtn" class="btn btn-outline-primary btn-sm"
              >下一页</button
            >
          </div>
        </div>
        <div class="card-body login-card-body">
          <button id="openBtn" class="btn btn-primary">新增评审</button>

          <!-- 弹窗 -->
          <div id="myModal" class="modal">
            <div class="modal-content">
              <span class="close">&times;</span>
              <form id="makeReviewerForm">
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-input"
                    placeholder="评审账号"
                    name="reviewerId"
                  />
                </div>
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-input"
                    placeholder="密码"
                    name="password"
                  />
                </div>

                <div class="input-group mb-3">
                  <!-- 下拉框 -->
                  <select id="dropdown" class="form-input" style="width: auto;">
                    <option value="" selected disabled>请选择领域</option>
                    <option value="软件应用与开发">软件应用与开发</option>
                    <option value="微课与AI辅助教学">微课与AI辅助教学</option>
                    <option value="物联网应用">物联网应用</option>
                    <option value="大数据应用">大数据应用</option>
                    <option value="人工智能应用">人工智能应用</option>
                    <option value="信息可视化设计">信息可视化设计</option>
                    <option value="数媒静态设计">数媒静态设计</option>
                    <option value="数媒动漫与短片">数媒动漫与短片</option>
                    <option value="数媒游戏与交互设计"
                      >数媒游戏与交互设计</option
                    >
                    <option value="计算机音乐创作">计算机音乐创作</option>
                    <option value="国际生“汉学”">国际生“汉学”</option>
                  </select>
                </div>

                <!--begin::Row-->
                <div class="row">
                  <div class="col-4">
                    <div class="d-grid gap-2">
                      <button
                        id="submitBtn"
                        type="button"
                        class="btn btn-primary">新建</button
                      >
                    </div>
                  </div>
                </div>
                <!--end::Row-->
              </form>
            </div>
          </div>
        </div>
      </div>

      <Footer />
    </div>
    <script>
      // 分页相关变量
      let currentPage = 1;
      const itemsPerPage = 10;
      let items = []; // 存储全部数据

      // 初始化函数
      function initPagination() {
        // 事件绑定
        document
          .getElementById("prevBtn")
          .addEventListener("click", () => changePage(-1));
        document
          .getElementById("nextBtn")
          .addEventListener("click", () => changePage(1));
      }

      // 渲染表格内容
      function renderTable() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = items.slice(start, end);

        const reviewerList = document.getElementById("reviewer-list");
        reviewerList.innerHTML = pageData
          .map(
            (item) => `
                <tr class="align-middle" key="${item.reviewerId}">
                  <td><div class="input-group">
                        <input
                          type="text"
                          class="form-control"
                          value="${item.reviewerId}"
                          disabled
                        />
                      </div>
                  </td>
                  <td><div class="input-group">
                        <input
                          id="update-password"
                          type="text"
                          class="form-control"
                          value="${item.password}"
                        />
                      </div>
                  </td>
                  <td>
                    <div class="input-group">
                        <select id="update-category"  class="form-control">
                          <option value="${item.category}" selected disabled>${item.category}</option>
                          <option value="软件应用与开发">软件应用与开发</option>
                          <option value="微课与AI辅助教学">微课与AI辅助教学</option>
                          <option value="物联网应用">物联网应用</option>
                          <option value="大数据应用">大数据应用</option>
                          <option value="人工智能应用">人工智能应用</option>
                          <option value="信息可视化设计">信息可视化设计</option>
                          <option value="数媒静态设计">数媒静态设计</option>
                          <option value="数媒动漫与短片">数媒动漫与短片</option>
                          <option value="数媒游戏与交互设计">数媒游戏与交互设计</option>
                          <option value="计算机音乐创作">计算机音乐创作</option>
                          <option value="国际生“汉学”">国际生“汉学”</option>
                        </select>
                      </div>
                  </td>
                  <td><button type="button" id="update-reviewer" class="btn btn-outline-primary" data-reviewerId="${item.reviewerId}">修改</button></td>
                  <td><button type="button" id="delete-reviewer" class="btn btn-outline-danger" data-reviewerId="${item.reviewerId}">删除</button></a></td>
                </tr>
              `
          )
          .join("");

        // 重新绑定事件
        bindButtonEvents();
        // 更新分页状态
        renderPagination();
      }

      // 生成分页按钮
      function renderPagination() {
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const pageNumbers = document.getElementById("pageNumbers");
        pageNumbers.innerHTML = "";

        // 显示页码范围（最多显示5个）
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement("button");
          btn.className = `btn btn-sm mx-1 ${i === currentPage ? "btn-primary" : "btn-outline-primary"}`;
          btn.textContent = i;
          btn.addEventListener("click", () => goToPage(i));
          pageNumbers.appendChild(btn);
        }

        // 控制按钮状态
        document.getElementById("prevBtn").disabled = currentPage === 1;
        document.getElementById("nextBtn").disabled =
          currentPage === totalPages;
      }

      // 分页控制函数
      function changePage(step) {
        currentPage = Math.max(1, currentPage + step);
        renderTable();
      }

      function goToPage(page) {
        currentPage = page;
        renderTable();
      }

      // 按钮事件绑定函数
      function bindButtonEvents() {
        // 给每个修改按钮添加点击事件
        document.querySelectorAll("#update-reviewer").forEach((button) => {
          button.addEventListener("click", function () {
            const reviewerId = this.getAttribute("data-reviewerId");
            var dropdown = document
              .querySelector(`[key="${reviewerId}"]`)
              ?.querySelector("#update-category");
            var selectedValue = dropdown?.value;
            const formData = {
              reviewerId: reviewerId,
              password: document
                .querySelector(`[key="${reviewerId}"]`)
                ?.querySelector("#update-password")?.value,
              category: selectedValue,
            };
            // 在这里处理修改逻辑
            console.log(`修改评委 : ${formData}`);
            fetch(`http://localhost:8080/manager/updateReviewer`, {
              method: "post",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(formData),
            })
              .then((response) => response.json())
              .then((data) => {
                if (data.code == 200) {
                  alert("修改评委信息成功");
                  window.location.href = "../manager/reviewer-manage.html";
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });

        // 给每个删除按钮添加点击事件
        document.querySelectorAll("#delete-reviewer").forEach((button) => {
          button.addEventListener("click", function () {
            const reviewerId = this.getAttribute("data-reviewerId");
            // 在这里处理删除逻辑
            console.log(`删除审核 reviewerId: ${reviewerId}`);
            fetch(
              `http://localhost:8080/manager/deleteReviewer?reviewerId=${reviewerId}`,
              {
                method: "get",
                credentials: "include",
                headers: {
                  "Content-Type": "application/json",
                },
              }
            )
              .then((response) => response.json())
              .then((data) => {
                if (data.code == 200) {
                  alert("删除审核成功");
                  window.location.href = "../manager/reviewer-manage.html";
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });
      }

      // 初始化分页
      initPagination();

      window.onload = function () {
        fetch(`http://localhost:8080/manager/getAllReviewer`, {
          method: "get",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              console.log(data.data);
              items = data.data; // 保存全部数据
              renderTable(); // 初始化渲染
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

