      // 获取元素
      var modal = document.getElementById("myModal");
      var btn = document.getElementById("openBtn");
      var span = document.getElementsByClassName("close")[0];
      var submitBtn = document.getElementById("submitBtn");

      // 打开弹窗
      btn.onclick = function () {
        modal.style.display = "block";
      };

      // 关闭弹窗
      span.onclick = function () {
        modal.style.display = "none";
      };

      // 点击提交按钮
      submitBtn.onclick = function () {
        // 获取表单数据
        const formData = {
          school: document.querySelector('[name="school"]').value,
          managerId: document.querySelector('[name="managerId"]').value,
          password: document.querySelector('[name="password"]').value,
          quota: document.querySelector('[name="quota"]').value,
        };

        fetch("http://localhost:8080/manager/makeSchoolManager", {
          method: "POST",
          credentials: "include", // 确保带上 Cookies
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(formData), // 发送表单数据
        })
          .then((response) => response.json()) // 假设后端返回的是 JSON 格式的响应
          .then((data) => {
            console.log(data.data);
            if (data.code === 200) {
              // 保存成功后处理
              modal.style.display = "none";
              alert("新建成功");
              window.location.href = "../manager/school-manage.html";
            } else {
              alert(data.message); // 保存失败时的提示
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

      // 点击弹窗外区域关闭弹窗
      window.onclick = function (event) {
        if (event.target === modal) {
          modal.style.display = "none";
        }
      };
    </script>

    <Scripts path={path} />
  </body>
</html>
