---
import Head from "@components/_head.astro";
import Scripts from "@components/_scripts.astro";
import Footer from "@components/dashboard/_footer.astro";
import Topbar from "@components/dashboard/_topbar.astro";
import Sidenav from "@components/dashboard/manager-sidenav.astro";

const title = "省赛管理员 - 参赛学校管理";
const path = "../../../dist";
const htmlPath = "..";
const mainPage = "manager";
const page = "school-manage";
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <style>
      /* 弹窗样式 */
      .modal {
        display: none; /* 初始时隐藏 */
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 400px;
      }

      .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
      }

      .close:hover,
      .close:focus {
        color: black;
        text-decoration: none;
        cursor: pointer;
      }
    </style>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <div class="card" style="width: 100%;height:100%">
        <div class="card-body login-card-body">
          <p class="login-box-msg">学校管理员</p>
          <table class="table table-bordered text-center table-valign-middle">
            <thead>
              <tr class="align-middle">
                <th>学校</th>
                <th>管理员账号</th>
                <th>管理员密码</th>
                <th>省赛配额</th>
                <th>操作</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="schoolManager-list"> </tbody>
          </table>
          <!-- 添加分页控件 -->
          <div class="pagination justify-content-center mt-3">
            <button id="prevBtn" class="btn btn-outline-primary btn-sm"
              >上一页</button
            >
            <span id="pageNumbers" class="mx-2"></span>
            <button id="nextBtn" class="btn btn-outline-primary btn-sm"
              >下一页</button
            >
          </div>
        </div>
        <div class="card-body login-card-body">
          <button id="openBtn" class="btn btn-primary">新增学校</button>

          <!-- 弹窗 -->
          <div id="myModal" class="modal">
            <div class="modal-content">
              <span class="close">&times;</span>
              <form id="makeSchoolManagerForm">
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-control"
                    placeholder="学校"
                    name="school"
                  />
                </div>
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-control"
                    placeholder="管理员账号"
                    name="managerId"
                  />
                </div>
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-control"
                    placeholder="管理员密码"
                    name="password"
                  />
                </div>
                <div class="input-group mb-3">
                  <input
                    type="text"
                    class="form-control"
                    placeholder="省赛配额"
                    name="quota"
                  />
                </div>

                <!--begin::Row-->
                <div class="row">
                  <div class="col-4">
                    <div class="d-grid gap-2">
                      <button
                        id="submitBtn"
                        type="button"
                        class="btn btn-primary">新建</button
                      >
                    </div>
                  </div>
                </div>
                <!--end::Row-->
              </form>
            </div>
          </div>
        </div>
      </div>

      <Footer />
    </div>
    <script>
      // 分页相关变量
      let currentPage = 1;
      const itemsPerPage = 10;
      let items = []; // 存储全部数据

      // 初始化函数
      function initPagination() {
        // 事件绑定
        document
          .getElementById("prevBtn")
          ?.addEventListener("click", () => changePage(-1));
        document
          .getElementById("nextBtn")
          ?.addEventListener("click", () => changePage(1));
      }

      // 渲染表格内容
      function renderTable() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageData = items.slice(start, end);

        const workList = document.getElementById("schoolManager-list");
        workList.innerHTML = pageData
          .map(
            (item) => `
                <tr class="align-middle" key="${item.managerId}">
                  <td><div class="input-group">
                        <input
                          type="text"
                          class="form-control"
                          value="${item.school}"
                          disabled
                        />
                      </div>
                  </td>
                  <td><div class="input-group">
                        <input
                          type="text"
                          class="form-control"
                          value="${item.managerId}"
                          disabled
                        />
                      </div>
                  </td>
                  <td><div class="input-group">
                        <input
                          id="revise-password"
                          type="text"
                          class="form-control"
                          value="${item.password}"
                        />
                      </div>
                  </td>
                  <td><div class="input-group">
                        <input
                          id="revise-quota"
                          type="text"
                          class="form-control"
                          value="${item.quota}"
                        />
                      </div>
                  </td>
                  <td><button type="button" id="revise-schoolManager" class="btn btn-outline-primary" data-managerId="${item.managerId}">修改</button></td>
                  <td><button type="button" id="delete-schoolManager" class="btn btn-outline-danger" data-managerId="${item.managerId}">删除</button></td>
                </tr>
              `
          )
          .join("");

        // 重新绑定事件
        bindButtonEvents();
        // 更新分页状态
        renderPagination();
      }

      // 生成分页按钮
      function renderPagination() {
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const pageNumbers = document.getElementById("pageNumbers");
        pageNumbers.innerHTML = "";

        // 显示页码范围（最多显示5个）
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement("button");
          btn.className = `btn btn-sm mx-1 ${i === currentPage ? "btn-primary" : "btn-outline-primary"}`;
          btn.textContent = i;
          btn.addEventListener("click", () => goToPage(i));
          pageNumbers.appendChild(btn);
        }

        // 控制按钮状态
        document.getElementById("prevBtn").disabled = currentPage === 1;
        document.getElementById("nextBtn").disabled =
          currentPage === totalPages;
      }

      // 分页控制函数
      function changePage(step) {
        currentPage = Math.max(1, currentPage + step);
        renderTable();
      }

      function goToPage(page) {
        currentPage = page;
        renderTable();
      }

      // 按钮事件绑定函数
      function bindButtonEvents() {
        // 给每个修改按钮添加点击事件
        document.querySelectorAll("#revise-schoolManager").forEach((button) => {
          button.addEventListener("click", function () {
            const managerId = this.getAttribute("data-managerId");
            const formData = {
              managerId: this.getAttribute("data-managerId"),
              password: document
                .querySelector(`[key="${managerId}"]`)
                ?.querySelector("#revise-password")?.value,
              quota: document
                .querySelector(`[key="${managerId}"]`)
                ?.querySelector("#revise-quota")?.value,
            };
            // 在这里处理修改逻辑
            console.log(`修改校管理员为: ${formData}`);
            fetch(`http://localhost:8080/manager/reviseSchoolManager`, {
              method: "post",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(formData), // 发送表单数据
            })
              .then((response) => response.json())
              .then((data) => {
                if (data.code == 200) {
                  alert("修改校管理员成功");
                  window.location.href = "../manager/school-manage.html";
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });

        // 给每个删除按钮添加点击事件
        document.querySelectorAll("#delete-schoolManager").forEach((button) => {
          button.addEventListener("click", function () {
            const managerId = this.getAttribute("data-managerId");
            // 在这里处理删除逻辑
            console.log(`删除校管理员 managerId: ${managerId}`);
            fetch(
              `http://localhost:8080/manager/deleteSchoolManager?managerId=${managerId}`,
              {
                method: "get",
                credentials: "include",
                headers: {
                  "Content-Type": "application/json",
                },
              }
            )
              .then((response) => response.json())
              .then((data) => {
                if (data.code == 200) {
                  alert("删除校管理员成功");
                  window.location.href = "../manager/school-manage.html";
                } else {
                  alert(data.message);
                }
              })
              .catch((error) => {
                console.error("请求失败:", error);
                alert("请求失败，请重试。");
              });
          });
        });
      }

      // 初始化分页
      initPagination();

      window.onload = function () {
        fetch(`http://localhost:8080/manager/getAllSchoolManager`, {
          method: "get",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.code === 200) {
              items = data.data; // 保存全部数据
              renderTable(); // 初始化渲染
            } else {
              alert(data.message);
            }
          })
          .catch((error) => {
            console.error("请求失败:", error);
            alert("请求失败，请重试。");
          });
      };

